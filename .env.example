# Copy to .env next to compose.yaml and edit. .env is ignored by Git.

# The public HTTPS address people open. Requests with any other Host are refused.
LEERR_ORIGIN=https://music.example.com

# The reverse proxy's address as Leerr sees it. A proxy on the Docker host
# connects through the gateway of the network pinned in compose.yaml.
LEERR_TRUST_PROXY=10.213.47.1

# The 32-byte key on this host, outside this checkout, readable by UID 1000.
LEERR_KEY_FILE=/etc/leerr/key

# Scheduled backups and a private CA are set up in compose.override.yaml;
# see docs/deployment.md.
