{
  "name": "leerr",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/main.ts",
    "preview": "npm run build:web && node server/preview.ts",
    "operator": "node server/operator.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test --test-reporter=spec \"server/**/*.test.ts\"",
    "lint": "oxlint --threads 1 --deny-warnings --config oxlint.config.ts server web && node scripts/check-anti-slop.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:web"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.3",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@oxlint/plugins": "1.82.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
