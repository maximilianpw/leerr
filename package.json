{
  "name": "leerr",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/main.ts",
    "preview": "npm run build:web && node server/preview.ts",
    "operator": "node server/operator.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p web/test/tsconfig.json",
    "test": "node --test --test-reporter=spec \"server/**/*.test.ts\" \"web/test/**/*.test.ts\"",
    "lint": "oxlint --threads 1 --deny-warnings --config oxlint.config.ts server web && node scripts/check-anti-slop.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:web"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@oxlint/plugins": "1.87.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.55.0",
    "oxlint": "1.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true
  }
}
