#!/usr/bin/env bash
set -euo pipefail

step() {
    printf '\n==> %s\n' "$1"
}

run_as_root() {
    if [[ "$(id -u)" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

temporary_directory="$(mktemp -d)"
trap 'rm -rf "$temporary_directory"' EXIT

step "Checking Swiftly prerequisites"
required_packages=(ca-certificates curl gpg)
missing_packages=()
for package in "${required_packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
        missing_packages+=("$package")
    fi
done

if (( ${#missing_packages[@]} > 0 )); then
    run_as_root env DEBIAN_FRONTEND=noninteractive apt-get update -q
    run_as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
fi

swiftly_home="${SWIFTLY_HOME_DIR:-$HOME/.local/share/swiftly}"
if [[ -f "$swiftly_home/env.sh" ]]; then
    # shellcheck disable=SC1090
    source "$swiftly_home/env.sh"
fi

if ! command -v swiftly >/dev/null 2>&1; then
    step "Installing Swiftly"
    curl --fail --location --silent --show-error \
        "https://download.swift.org/swiftly/linux/swiftly-$(uname -m).tar.gz" \
        --output "$temporary_directory/swiftly.tar.gz"
    tar -xzf "$temporary_directory/swiftly.tar.gz" -C "$temporary_directory"
    "$temporary_directory/swiftly" init \
        --assume-yes \
        --no-modify-profile \
        --skip-install \
        --quiet-shell-followup
    # shellcheck disable=SC1090
    source "$swiftly_home/env.sh"
fi

profile_marker="# Leerr Swiftly environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# Leerr Swiftly environment
if [[ -f "$HOME/.local/share/swiftly/env.sh" ]]; then
    source "$HOME/.local/share/swiftly/env.sh"
fi
EOF
fi

step "Installing the pinned Swift toolchain"
swift_version="$(tr -d '[:space:]' < .swift-version)"
post_install_file="$temporary_directory/swift-post-install.sh"
swiftly install \
    --assume-yes \
    --post-install-file "$post_install_file" \
    "$swift_version"
if [[ -s "$post_install_file" ]]; then
    run_as_root env DEBIAN_FRONTEND=noninteractive bash "$post_install_file"
fi

step "Resolving Swift package dependencies"
swift package resolve

step "Orb setup complete"
swift --version
